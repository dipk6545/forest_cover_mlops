# ==============================================================================
# Forest Cover Type MLOps Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure with your service endpoints and credentials.
# DO NOT commit the active .env file to version control.

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration (Aiven / Managed / Local)
# Used for MLflow tracking backend and live Grafana inference metrics table
# ------------------------------------------------------------------------------
MLFLOW_TRACKING_URI=postgresql+psycopg2://<username>:<password>@<host>:<port>/<database>?sslmode=require
PGHOST=<host>
PGPORT=25007
PGUSER=<username>
PGPASSWORD=<password>
PGDATABASE=defaultdb

# ------------------------------------------------------------------------------
# 2. Cloudflare R2 / S3-Compatible Object Storage (Model & Artifact Registry)
# ------------------------------------------------------------------------------
R2_BUCKET_NAME=netsentry
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=<your_r2_access_key_id>
AWS_SECRET_ACCESS_KEY=<your_r2_secret_access_key>
AWS_DEFAULT_REGION=auto
MLFLOW_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
MLFLOW_ARTIFACT_ROOT=s3://netsentry/forest-cover-mlops/artifacts

# ------------------------------------------------------------------------------
# 3. Apache Kafka & Serving Configuration
# ------------------------------------------------------------------------------
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC_RAW=terrain_survey.raw
KAFKA_TOPIC_PRED=terrain_survey.predictions
KAFKA_GROUP_ID=forest-scoring-group
API_PREDICT_URL=http://localhost:8000/predict

# ------------------------------------------------------------------------------
# 4. Hosted Grafana Cloud (Observability)
# ------------------------------------------------------------------------------
GRAFANA_URL=https://<your-org>.grafana.net
GRAFANA_API_KEY=<glsa_service_account_token>
