# ==============================================================================
# MLOps Cloud & Tracking Credentials Template
# Copy this file to .env and fill in your values
# ==============================================================================

# PostgreSQL for MLflow tracking metadata
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Cloudflare R2 / S3-Compatible Object Storage for MLflow Artifacts & DVC
R2_BUCKET_NAME=netsentry
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=<your_r2_access_key>
AWS_SECRET_ACCESS_KEY=<your_r2_secret_key>
AWS_DEFAULT_REGION=auto
MLFLOW_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
MLFLOW_ARTIFACT_ROOT=s3://netsentry/forest-cover-mlops/artifacts
